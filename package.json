{
  "name": "hatzolah-cpg-pwa",
  "version": "1.0.0",
  "description": "Hatzolah Clinical Practice Guidelines PWA with fuzzy search",
  "private": true,
  "homepage": "https://ilyulev.github.io/hatzolah-cpg",
  "dependencies": {
    "lucide-react": "^0.263.1",
    "pdf-parse-fork": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.27",
    "gh-pages": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "terser": "^5.44.0",
    "vite": "^7.1.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp_sw.mjs",
    "preview": "vite preview",
    "predeploy": "pnpm run build",
    "deploy": "pnpx gh-pages -d dist",
    "extract-pdf": "node scripts/extract_pdf.mjs",
    "extract-tables": "node scripts/extract_tables.mjs",
    "compare-tables": "node scripts/compare_tables.mjs",
    "prose-diff": "node scripts/prose_diff.mjs",
    "audit-coverage": "node scripts/audit_coverage.mjs",
    "pagemap": "node scripts/pagemap.mjs",
    "check-age-bands": "node scripts/check_age_bands.mjs",
    "render-pages": "osascript -l JavaScript scripts/render_cpg_pages.jxa.js \"$PWD/source/Compiled_v6_2.pdf\" \"$PWD/scripts/output/pages\" 2",
    "explain-coverage": "node scripts/explain_coverage.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
