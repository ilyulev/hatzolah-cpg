# Directory-form ignores: nothing under these is tracked, even their *.json
# (the dir form means the !*.json re-include below cannot resurrect files here).
node_modules/
dist/
# Derived CPG audit artifacts: rendered page images (~29 MB), per-protocol
# content dumps and audit results. All regenerable from the source PDF.
scripts/output/pages/
scripts/output/content/
scripts/output/audit/
scripts/output/regen/
scripts/output/regen-prenest/
scripts/output/content-v62/

# Temp module the content assembler writes next to contentData.js while it
# evaluates the current exports. Removed in a finally block, but a hard crash
# can still leave one behind - never commit it.
src/data/.cd-assemble-*.mjs

# Local CPG source PDF (do not commit binary)
source/*.pdf

# This machine's global gitignore excludes *.json — re-include so this repo's
# tracked config (package.json, manifests, scripts data) isn't lost.
!*.json
# ...but never track these:
# npm artifact — pnpm-only project
package-lock.json
# machine-local Claude settings (settings.json holds this machine's gateway
# diagnostic hook, not project config a teammate needs)
.claude/settings.local.json
.claude/settings.json
# ...and the script that hook invokes
scripts/check-gateway.sh
